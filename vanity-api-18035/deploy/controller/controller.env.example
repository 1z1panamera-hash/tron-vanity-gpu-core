VANITY18035_ENV=production
VANITY18035_HOST=0.0.0.0
VANITY18035_PORT=18035
VANITY18035_DB=/opt/vanity-api-18035/data/controller.sqlite3
VANITY18035_CUSTOMER_IPS=192.0.2.10
VANITY18035_WORKER_IPS=192.0.2.20
VANITY18035_WORKER_ID=worker-0001
VANITY18035_CALLBACK_URL=https://customer.example/vanity-result
VANITY18035_AGE_RECIPIENT=age1replace_with_customer_public_recipient
VANITY18035_TLS_CERT=/etc/vanity-api-18035/tls/server-fullchain.pem
VANITY18035_TLS_KEY=/etc/vanity-api-18035/tls/server.key
VANITY18035_WORKER_CA=/etc/vanity-api-18035/tls/worker-ca.crt
VANITY18035_REQUIRE_WORKER_MTLS=true
VANITY18035_ALLOW_INSECURE_LOCAL=false
VANITY18035_P0_MAX_INFLIGHT=8
VANITY18035_P0_HARD_TIMEOUT=10
VANITY18035_P0_HTTP_TIMEOUT=15
VANITY18035_P0_CACHE_SECONDS=60
VANITY18035_WORKER_STALE_SECONDS=5
VANITY18035_CLOCK_SKEW_SECONDS=30
