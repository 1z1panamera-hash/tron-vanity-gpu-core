VANITY18035_ENV=production
VANITY18035_WORKER_ID=worker-0001
VANITY18035_CONTROLLER_URL=https://controller.example:18035
VANITY18035_WORKER_DB=/opt/vanity-api-18035/data/worker.sqlite3
VANITY18035_CORE_SOCKET=/run/vanity-api-18035/core.sock
VANITY18035_AGE_RECIPIENT=age1replace_with_customer_public_recipient
VANITY18035_CONTROLLER_CA=/etc/vanity-api-18035/tls/controller-ca.crt
VANITY18035_WORKER_CERT=/etc/vanity-api-18035/tls/worker.crt
VANITY18035_WORKER_KEY=/etc/vanity-api-18035/tls/worker.key
VANITY18035_ALLOW_INSECURE_LOCAL=false
VANITY18035_HEARTBEAT_SECONDS=1
VANITY18035_RECONNECT_MIN=0.1
VANITY18035_RECONNECT_MAX=5
