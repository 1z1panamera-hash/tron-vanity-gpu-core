+  for (int i = 24; i >= 0 && carry != 0; --i) {
+    uint32_t v = static_cast<uint32_t>(value[i]) + (carry & 0xffU);
+    value[i] = static_cast<uint8_t>(v & 0xffU);
+    carry = (carry >> 8) + (v >> 8);
