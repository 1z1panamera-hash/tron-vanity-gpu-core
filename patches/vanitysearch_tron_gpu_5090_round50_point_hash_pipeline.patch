+__device__ __forceinline__ void StoreTronPipelinePoint(
+    uint64_t *points,
+    uint32_t nbThread,
+    uint32_t offset,
+    const uint64_t *px,
+    const uint64_t *py) {
+  const uint32_t tid = (blockIdx.x * blockDim.x) + threadIdx.x;
+  const uint32_t pointCount = nbThread * GRP_SIZE;
+  const uint32_t pointIndex = offset * nbThread + tid;
+#pragma unroll
+  for (int limb = 0; limb < 4; ++limb) {
+    points[limb * pointCount + pointIndex] = px[limb];
+    points[(limb + 4) * pointCount + pointIndex] = py[limb];
+  }
+}
+
+__device__ void ComputeKeysTronPointBatch(
+    uint64_t *startx,
+    uint64_t *starty,
+    uint64_t *points,
+    uint32_t nbThread) {
+  uint64_t dx[GRP_SIZE / 2 + 1][4];
+  uint64_t px[4];
+  uint64_t py[4];
+  uint64_t pyn[4];
+  uint64_t sx[4];
+  uint64_t sy[4];
+  uint64_t dy[4];
+  uint64_t _s[4];
+  uint64_t _p2[4];
+
+  __syncthreads();
+  Load256A(sx, startx);
+  Load256A(sy, starty);
+  Load256(px, sx);
+  Load256(py, sy);
+
+  uint32_t i;
+  for (i = 0; i < HSIZE; ++i) ModSub256(dx[i], Gx[i], sx);
+  ModSub256(dx[i], Gx[i], sx);
+  ModSub256(dx[i + 1], _2Gnx, sx);
+  _ModInvGrouped(dx);
+
+  StoreTronPipelinePoint(points, nbThread, GRP_SIZE / 2, px, py);
+  ModNeg256(pyn, py);
+
+  for (i = 0; i < HSIZE; ++i) {
+    __syncthreads();
+    Load256(px, sx);
+    Load256(py, sy);
+    ModSub256(dy, Gy[i], py);
+    _ModMult(_s, dy, dx[i]);
+    _ModSqr(_p2, _s);
+    ModSub256(px, _p2, px);
+    ModSub256(px, Gx[i]);
+    ModSub256(py, Gx[i], px);
+    _ModMult(py, _s);
+    ModSub256(py, Gy[i]);
+    StoreTronPipelinePoint(points, nbThread, GRP_SIZE / 2 + (i + 1), px, py);
+
+    __syncthreads();
+    Load256(px, sx);
+    ModSub256(dy, pyn, Gy[i]);
+    _ModMult(_s, dy, dx[i]);
+    _ModSqr(_p2, _s);
+    ModSub256(px, _p2, px);
+    ModSub256(px, Gx[i]);
+    ModSub256(py, px, Gx[i]);
+    _ModMult(py, _s);
+    ModSub256(py, Gy[i], py);
+    StoreTronPipelinePoint(points, nbThread, GRP_SIZE / 2 - (i + 1), px, py);
+  }
+
+  __syncthreads();
+  Load256(px, sx);
+  Load256(py, sy);
+  ModNeg256(dy, Gy[i]);
+  ModSub256(dy, py);
+  _ModMult(_s, dy, dx[i]);
+  _ModSqr(_p2, _s);
+  ModSub256(px, _p2, px);
+  ModSub256(px, Gx[i]);
+  ModSub256(py, px, Gx[i]);
+  _ModMult(py, _s);
+  ModSub256(py, Gy[i], py);
+  StoreTronPipelinePoint(points, nbThread, 0, px, py);
+
+  ++i;
+  __syncthreads();
+  Load256(px, sx);
+  Load256(py, sy);
+  ModSub256(dy, _2Gny, py);
+  _ModMult(_s, dy, dx[i]);
+  _ModSqr(_p2, _s);
+  ModSub256(px, _p2, px);
+  ModSub256(px, _2Gnx);
+  ModSub256(py, _2Gnx, px);
+  _ModMult(py, _s);
+  ModSub256(py, _2Gny);
+
+  __syncthreads();
+  Store256A(startx, px);
+  Store256A(starty, py);
+}
+
+template <bool UsePrefix, int Endo>
+__device__ void HashTronPipelineCandidate(
+    const uint64_t *points,
+    uint32_t pointCount,
+    uint32_t nbThread,
+    uint32_t groupOffset,
+    uint64_t suffix5Value,
+    uint32_t maxFound,
+    uint32_t *out) {
+  const uint32_t pointIndex = (blockIdx.x * blockDim.x) + threadIdx.x;
+  if (pointIndex >= pointCount) return;
+
+  uint64_t x[4];
+#pragma unroll
+  for (int limb = 0; limb < 4; ++limb) x[limb] = points[limb * pointCount + pointIndex];
+  if (Endo == 1) {
+    uint64_t transformed[4];
+    _ModMult(transformed, x, _beta);
+    Load256(x, transformed);
+  } else if (Endo == 2) {
+    uint64_t transformed[4];
+    _ModMult(transformed, x, _beta2);
+    Load256(x, transformed);
+  }
+
+  uint64_t y[4];
+#pragma unroll
+  for (int limb = 0; limb < 4; ++limb) y[limb] = points[(limb + 4) * pointCount + pointIndex];
+  const uint64_t y0 = tron_keccak_coord_lane(y, 0);
+  const uint64_t y1 = tron_keccak_coord_lane(y, 1);
+  const uint64_t y2 = tron_keccak_coord_lane(y, 2);
+  const uint64_t y3 = tron_keccak_coord_lane(y, 3);
+  uint8_t payload21[21];
+  if (!tron_check_x_suffix5_fixed64_with_y_lanes<UsePrefix>(
+          x, y0, y1, y2, y3, suffix5Value, false, payload21)) {
+    return;
+  }
+
+  const uint32_t offset = pointIndex / nbThread;
+  const uint32_t tid = pointIndex - offset * nbThread;
+  const uint32_t pos = atomicAdd(out, 1);
+  if (pos < maxFound) {
+    out[pos * ITEM_SIZE32 + 1] = tid;
+    out[pos * ITEM_SIZE32 + 2] =
+        (uint32_t)((groupOffset + offset) << 16) | (uint32_t)Endo;
+    uint8_t *hashOut = reinterpret_cast<uint8_t *>(out + pos * ITEM_SIZE32 + 3);
+#pragma unroll
+    for (int byte = 0; byte < 20; ++byte) hashOut[byte] = payload21[byte + 1];
+  }
+}
+
+#endif
