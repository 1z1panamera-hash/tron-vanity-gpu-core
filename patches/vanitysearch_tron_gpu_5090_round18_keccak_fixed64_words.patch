+__device__ __forceinline__ uint64_t tron_keccak_coord_lane(
+    const uint64_t *coord,
+    int lane) {
+  const uint32_t *coord32 = reinterpret_cast<const uint32_t *>(coord);
+  const int hi = 7 - lane * 2;
+  const int lo = hi - 1;
+  return static_cast<uint64_t>(tron_bswap32(coord32[hi])) |
+         (static_cast<uint64_t>(tron_bswap32(coord32[lo])) << 32);
+}
