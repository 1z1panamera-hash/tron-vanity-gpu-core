+#ifdef TRON_ENABLE_BASE58_LINEAR_RESIDUE
+__device__ __forceinline__ uint64_t tron_payload_words_base58p5_linear_residue(
+    uint32_t w0,
+    uint32_t w1,
+    uint32_t w2,
+    uint32_t w3,
+    uint32_t w4,
+    uint32_t w5,
+    uint32_t checksum4_be32) {
+  const uint32_t d0 = ((w0 & 0x00ffffffU) << 8) | (w1 >> 24);
+  const uint32_t d1 = ((w1 & 0x00ffffffU) << 8) | (w2 >> 24);
+  const uint32_t d2 = ((w2 & 0x00ffffffU) << 8) | (w3 >> 24);
+  const uint32_t d3 = ((w3 & 0x00ffffffU) << 8) | (w4 >> 24);
+  const uint32_t d4 = ((w4 & 0x00ffffffU) << 8) | (w5 >> 24);
+
+  uint64_t value = 146167680ULL;
+  value += static_cast<uint64_t>(d0) * 289024608ULL;
+  value += static_cast<uint64_t>(d1) * 21339008ULL;
+  value += static_cast<uint64_t>(d2) * 357132832ULL;
+  value += static_cast<uint64_t>(d3) * 410450016ULL;
+  value += static_cast<uint64_t>(d4) * 356826688ULL;
+  value += static_cast<uint64_t>(checksum4_be32);
+  return tron_mod58p5_fast_u64(value);
+}
+#endif
