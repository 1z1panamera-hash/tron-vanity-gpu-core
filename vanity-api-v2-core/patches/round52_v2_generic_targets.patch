+bool GPUEngine::SetTronPatternsV2(const std::vector<std::string> &patterns) {
+  if (patterns.empty() || patterns.size() > TRON_V2_MAX_TARGETS) {
+    printf("GPUEngine: TRON V2 requires 1..%d patterns\n", TRON_V2_MAX_TARGETS);
+    return false;
+  }
+  std::vector<TronPatternV2Descriptor> targets;
+  targets.reserve(patterns.size());
+  for (size_t index = 0; index < patterns.size(); ++index) {
+    const std::string &pattern = patterns[index];
+    const size_t wildcard = pattern.find('*');
+    if (pattern.empty() || pattern[0] != 'T' || wildcard == std::string::npos ||
+        pattern.find('*', wildcard + 1) != std::string::npos) {
+      printf("GPUEngine: invalid TRON V2 pattern at index %zu\n", index);
+      return false;
+    }
+    const size_t prefixLength = wildcard - 1;
+    const size_t suffixLength = pattern.size() - wildcard - 1;
+    const size_t totalLength = prefixLength + suffixLength;
+    if (totalLength < 6 || totalLength > 8) {
+      printf("GPUEngine: TRON V2 pattern length must total 6, 7, or 8\n");
+      return false;
+    }
+    TronPatternV2Descriptor target;
+    memset(&target, 0, sizeof(target));
+    target.targetId = static_cast<uint32_t>(index);
+    target.prefixLength = static_cast<uint8_t>(prefixLength);
+    target.suffixLength = static_cast<uint8_t>(suffixLength);
+    target.totalCustomLength = static_cast<uint8_t>(totalLength);
+    target.suffixModulus = 1;
+    if (prefixLength != 0) {
+      TronPrefixRange range;
+      if (!host_make_tron_prefix_range(pattern.c_str(), wildcard, &range)) {
+        printf("GPUEngine: invalid TRON V2 prefix at index %zu\n", index);
+        return false;
+      }
+      target.flags |= TRON_V2_HAS_PREFIX;
+      host_payload25_words(range.low, target.prefixLow);
+      host_payload25_words(range.high, target.prefixHigh);
+      memcpy(target.payloadLow, range.possibleLowWords, sizeof(target.payloadLow));
+      memcpy(target.payloadHigh, range.possibleHighWords, sizeof(target.payloadHigh));
+    }
+    if (suffixLength != 0) {
+      if (!host_tron_suffix_value(
+              pattern.c_str() + wildcard + 1,
+              suffixLength,
+              &target.suffixValue,
+              &target.suffixModulus)) {
+        printf("GPUEngine: invalid TRON V2 suffix at index %zu\n", index);
+        return false;
+      }
+      target.flags |= TRON_V2_HAS_SUFFIX;
+    }
+    targets.push_back(target);
+  }
+  return SetTronPatternsV2(targets);
+}
