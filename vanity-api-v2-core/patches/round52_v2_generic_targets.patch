+bool GPUEngine::SetTronPatternsV2(
+    const std::vector<TronPatternV2Descriptor> &targets) {
+  if (targets.empty() || targets.size() > TRON_V2_MAX_TARGETS) {
+    printf("GPUEngine: TRON V2 requires 1..%d targets\n", TRON_V2_MAX_TARGETS);
+    return false;
+  }
+  for (size_t index = 0; index < targets.size(); ++index) {
+    const TronPatternV2Descriptor &target = targets[index];
+    if (target.totalCustomLength < 6 || target.totalCustomLength > 8 ||
+        target.prefixLength + target.suffixLength != target.totalCustomLength ||
+        (target.flags & (TRON_V2_HAS_PREFIX | TRON_V2_HAS_SUFFIX)) == 0U ||
+        ((target.flags & TRON_V2_HAS_SUFFIX) != 0U && target.suffixModulus == 0U)) {
+      printf("GPUEngine: invalid TRON V2 target at index %zu\n", index);
+      return false;
+    }
+  }
+  const uint32_t targetCount = static_cast<uint32_t>(targets.size());
+  cudaError_t error = cudaMemcpyToSymbol(
+      tronV2TargetsConst,
+      targets.data(),
+      targetCount * sizeof(TronPatternV2Descriptor));
+  if (error == cudaSuccess) {
+    error = cudaMemcpyToSymbol(
+        tronV2TargetCountConst, &targetCount, sizeof(targetCount));
+  }
+  if (error != cudaSuccess) {
+    printf("GPUEngine: SetTronPatternsV2: %s\n", cudaGetErrorString(error));
+    return false;
   }
+  hasPattern = true;
   hasTronRule = true;
+  hasTronV2Targets = true;
+  hasTronPrefixRange = false;
   return true;
+}

