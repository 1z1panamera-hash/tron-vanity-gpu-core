+size_t GPUEngine::GetKeyStateWordCount() const {
+  return static_cast<size_t>(nbThread) * 8U;
+}
+
+bool GPUEngine::ExportKeyState(std::vector<uint64_t> &state) {
+  const size_t wordCount = GetKeyStateWordCount();
+  state.resize(wordCount);
+  const cudaError_t error = cudaMemcpy(
+      state.data(), inputKey, wordCount * sizeof(uint64_t), cudaMemcpyDeviceToHost);
+  if (error != cudaSuccess) {
+    printf("GPUEngine: ExportKeyState: %s\n", cudaGetErrorString(error));
+    state.clear();
+    return false;
+  }
+  return true;
+}
+
+bool GPUEngine::ImportKeyState(const std::vector<uint64_t> &state) {
+  const size_t wordCount = GetKeyStateWordCount();
+  if (state.size() != wordCount) {
+    printf("GPUEngine: ImportKeyState: invalid state size\n");
+    return false;
+  }
+  const cudaError_t error = cudaMemcpy(
+      inputKey, state.data(), wordCount * sizeof(uint64_t), cudaMemcpyHostToDevice);
+  if (error != cudaSuccess) {
+    printf("GPUEngine: ImportKeyState: %s\n", cudaGetErrorString(error));
+    return false;
+  }
+  return callKernel();
+}
